# ==============================================================================
# VOICEGUARD - Backend Messaging & SMS Gateway Configuration
# Team: SUPREME | IEEE Computer Society Hackathon
# ==============================================================================

# SAFE TEST MODE:
# Set to 'true' during testing and development to use the VOICEGUARD Safe Test Sandbox.
# This simulates provider responses without incurring billing or sending real alerts.
# Set to 'false' only in production when real API credentials below are provided.
VOICEGUARD_TEST_MODE=true

# Designated test recipient phone numbers (comma-separated E.164 format)
TEST_RECIPIENT_NUMBERS=+919113822011,+919742803280

# ------------------------------------------------------------------------------
# Option 1: WhatsApp Business Cloud API (Meta Graph API v18.0+)
# To enable real automated WhatsApp messages directly to contacts:
# 1. Create a Meta Developer account at https://developers.facebook.com
# 2. Set up an App with the "WhatsApp Business" product
# 3. Generate a System User / Permanent Access Token with whatsapp_business_messaging
# 4. Copy your Phone Number ID and Access Token below
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_TEMPLATE_NAME=emergency_alert

# ------------------------------------------------------------------------------
# Option 2: Twilio SMS Gateway
# To enable real automated SMS directly to cell carriers (Airtel, Jio, etc.):
# 1. Sign up at https://www.twilio.com
# 2. Obtain your Account SID, Auth Token, and Twilio phone number
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# Option 3: Generic SMS Gateway / Custom Webhook
# ------------------------------------------------------------------------------
# SMS_GATEWAY_URL=https://api.your-sms-provider.com/v1/messages
# SMS_GATEWAY_API_KEY=
# SMS_GATEWAY_SENDER_ID=VOXGUARD
